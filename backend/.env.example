PORT=4000
DATABASE_SSL_CA=certs/prod-ca-2021.crt
DATABASE_URL=postgres://postgres:password@localhost:5432/my_paushe
CLIENT_ORIGIN=http://localhost:8081
# Set a unique random secret (at least 32 characters) for signing customer sessions.
AUTH_TOKEN_SECRET=replace-with-a-random-secret-at-least-32-characters-long
# Comma-separated Google web/Android/iOS client IDs accepted by the auth endpoint.
GOOGLE_CLIENT_IDS=
# Configure these only after registering for M-Pesa Daraja:
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://your-domain.example/api/payments/mpesa/callback
