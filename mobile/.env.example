EXPO_PUBLIC_API_URL=http://192.168.1.20:4000
# Create OAuth client IDs in Google Cloud Console and use one ID for each platform.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Restrict this key to the web app origin and Maps JavaScript API.
EXPO_PUBLIC_GOOGLE_MAPS_WEB_API_KEY=
# Restrict these keys to the My Paushe Android/iOS apps and Maps SDKs.
GOOGLE_MAPS_ANDROID_API_KEY=
GOOGLE_MAPS_IOS_API_KEY=
